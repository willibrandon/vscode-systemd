{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "systemd",
  "scopeName": "source.systemd",
  "patterns": [
    { "include": "#comments" },
    { "include": "#sections" },
    { "include": "#assignments" },
    { "include": "#templates" }
  ],
  "repository": {
    "comments": {
      "patterns": [{ "name": "comment.line.number-sign.systemd", "match": "^\\s*[#;].*$" }]
    },
    "sections": {
      "patterns": [{
        "name": "meta.section.systemd",
        "match": "^\\s*(\\[)([A-Za-z0-9_.:-]+)(\\])\\s*$",
        "captures": {
          "1": { "name": "punctuation.definition.section.begin.systemd" },
          "2": { "name": "entity.name.section.systemd" },
          "3": { "name": "punctuation.definition.section.end.systemd" }
        }
      }]
    },
    "assignments": {
      "patterns": [{
        "name": "meta.assignment.systemd",
        "begin": "^\\s*([A-Za-z][A-Za-z0-9_:@{}.-]*)(\\s*=)",
        "beginCaptures": {
          "1": { "name": "support.type.property-name.systemd" },
          "2": { "name": "keyword.operator.assignment.systemd" }
        },
        "end": "(?<!\\\\)$",
        "patterns": [
          { "name": "constant.language.boolean.systemd", "match": "(?i)(?<![A-Za-z])(yes|no|true|false|on|off)(?![A-Za-z])" },
          { "name": "constant.numeric.systemd", "match": "(?<![A-Za-z0-9_])[+-]?[0-9]+(?:\\.[0-9]+)?(?:ns|us|µs|ms|s|min|h|d|w|month|y|K|M|G|T|%|B)?(?![A-Za-z0-9_])" },
          { "name": "variable.other.systemd.specifier", "match": "%(?:%|[A-Za-z])" },
          { "name": "variable.other.systemd.environment", "match": "\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?" },
          { "name": "string.quoted.double.systemd", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.systemd", "match": "\\\\." }] },
          { "name": "string.quoted.single.systemd", "begin": "'", "end": "'" }
        ]
      }]
    },
    "templates": {
      "patterns": [
        { "name": "meta.template.expression.jinja", "begin": "\\{[{%#]", "end": "[}%#]\\}" },
        { "name": "meta.template.expression.erb", "begin": "<%", "end": "%>" }
      ]
    }
  }
}
