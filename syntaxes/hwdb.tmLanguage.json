{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "systemd hardware database",
  "scopeName": "source.systemd.hwdb",
  "patterns": [
    { "name": "comment.line.number-sign.systemd", "match": "^#.*$" },
    {
      "name": "meta.assignment.hwdb",
      "match": "^( +)([A-Z][A-Za-z0-9_]*)(=)([^#]*)(#.*)?$",
      "captures": {
        "2": { "name": "support.type.property-name.hwdb" },
        "3": { "name": "keyword.operator.assignment.hwdb" },
        "4": { "name": "string.unquoted.hwdb" },
        "5": { "name": "comment.line.number-sign.systemd" }
      }
    },
    {
      "name": "meta.match.hwdb",
      "match": "^([^#\\s][^#]*)(#.*)?$",
      "captures": {
        "1": { "name": "entity.name.tag.hwdb" },
        "2": { "name": "comment.line.number-sign.systemd" }
      }
    }
  ]
}
