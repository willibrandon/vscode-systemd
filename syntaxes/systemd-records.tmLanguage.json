{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "systemd records",
  "scopeName": "source.systemd.records",
  "patterns": [
    { "name": "comment.line.number-sign.systemd", "match": "^\\s*[#;].*$" },
    {
      "name": "meta.assignment.systemd",
      "match": "^\\s*([A-Za-z0-9_.*\\/-]+)(\\s*=)(.*)$",
      "captures": {
        "1": { "name": "support.type.property-name.systemd" },
        "2": { "name": "keyword.operator.assignment.systemd" },
        "3": { "name": "string.unquoted.systemd" }
      }
    },
    { "name": "constant.language.boolean.systemd", "match": "(?i)(?<![A-Za-z])(yes|no|true|false|on|off)(?![A-Za-z])" },
    { "name": "constant.numeric.systemd", "match": "(?<!\\S)[+-]?[0-9]+(?:\\.[0-9]+)?(?:s|min|h|d|K|M|G|T|%)?(?!\\S)" },
    { "name": "variable.other.systemd.specifier", "match": "%(?:%|[A-Za-z])" },
    { "name": "string.quoted.double.systemd", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.systemd", "match": "\\\\." }] },
    { "name": "string.quoted.single.systemd", "begin": "'", "end": "'" },
    { "name": "string.unquoted.systemd", "match": "\\S+" }
  ]
}
